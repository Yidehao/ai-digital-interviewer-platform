{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interviewer.org/tools/score_response.json",
  "title": "score_response",
  "description": "Record a private working score for one competency, on a scale of 1 to 5 where 1 is poor and 5 is excellent. This steers your own planning; it is not the final grade and the candidate never sees it.",
  "type": "object",
  "properties": {
    "questionId": {
      "type": "string"
    },
    "dimension": {
      "type": "string",
      "enum": ["correctness", "depth", "communication", "practical_experience"]
    },
    "score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Integer from 1 (poor) to 5 (excellent). Must not exceed 5."
    },
    "evidence": {
      "type": "string",
      "maxLength": 400
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium"
    }
  },
  "required": ["questionId", "dimension", "score", "evidence"],
  "additionalProperties": false
}

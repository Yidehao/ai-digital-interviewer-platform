<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.interviewer.mapper.QuestionLibMapperCustom">

    <select id="queryQuestionLibList" parameterType="map" resultType="org.interviewer.entity.vo.QuestionLibVO">
        SELECT
            q.id as questionLibId,
            q.question as question,
            q.reference_answer as referenceAnswer,
            q.ai_src as aiSrc,
            q.is_on as isOn,
            q.interviewer_id as interviewerId,
            i.ai_name as interviewerName,
            q.create_time as createTime,
            q.updated_time as updatedTime
        FROM
            question_lib q
                LEFT JOIN
            interviewer i
            ON
            q.interviewer_id = i.id
        WHERE
            1 = 1
            <if test="paramMap.aiName != null and paramMap.aiName != ''">
                AND i.ai_name LIKE concat('%', #{paramMap.aiName},'%')
            </if>
            <if test="paramMap.question != null and paramMap.question != ''">
                AND q.question LIKE concat('%', #{paramMap.question},'%')
            </if>
    </select>

    <!--
        Random enabled questions for one interviewer, in a single query.

        Replaces a per-question `LIMIT #{indexNum}, 1` lookup whose offsets were computed from a
        count filtered by interviewer_id while the query itself filtered only on is_on - so it
        could return another interviewer's questions, and could overrun the offset and return
        null rows into the list.

        The column list is explicit and omits reference_answer on purpose: this result is sent
        to the candidate's device.
    -->
    <select id="queryRandomQuestions" parameterType="map" resultType="org.interviewer.entity.vo.InitQuestionsVO">
        SELECT
            q.id            as id,
            q.question      as question,
            q.ai_src        as aiSrc,
            q.interviewer_id as interviewerId
        FROM
            question_lib q
        WHERE
            q.is_on = 1
            AND q.interviewer_id = #{paramMap.interviewerId}
            <if test="paramMap.excludeIds != null and paramMap.excludeIds.size() > 0">
                AND q.id NOT IN
                <foreach item="excludeId" collection="paramMap.excludeIds" open="(" separator="," close=")">
                    #{excludeId}
                </foreach>
            </if>
        ORDER BY RAND()
        LIMIT #{paramMap.num}
    </select>

</mapper>
